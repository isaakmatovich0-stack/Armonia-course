{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/store/shipping",
      "destination": "/store/shipping.html"
    },
    {
      "source": "/store/care",
      "destination": "/store/care.html"
    },
    {
      "source": "/store/contact",
      "destination": "/store/contact.html"
    }
  ],
  "redirects": [
    {
      "source": "/shop",
      "destination": "/store/",
      "permanent": false
    },
    {
      "source": "/merch",
      "destination": "/store/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/store/frontend.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/store/live.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/store/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/store/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/store/supplier-sync",
      "schedule": "0 14 * * *"
    }
  ]
}
