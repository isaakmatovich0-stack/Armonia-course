# Copy this file's contents into Vercel: Project -> Settings -> Environment Variables
# Never commit a real .env file to GitHub.

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...           # Stripe Dashboard -> Developers -> API keys

# There are two webhook endpoints, and Stripe gives each one its own signing
# secret:
#   /api/webhook        course sales  (access code + receipt email)
#   /api/store/webhook  merch orders  (order book + receipt email)
# Each endpoint accepts either variable, so you can use one secret for both, or
# keep them separate for independent rotation. If you only set one, set it here:
STRIPE_WEBHOOK_SECRET=whsec_...         # course endpoint's secret (README step 4)
STRIPE_WEBHOOK_SECRET_STORE=whsec_...   # store endpoint's secret — optional, falls back to the line above

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co  # Supabase Dashboard -> Project Settings -> API
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # Same page -> "service_role" key (NOT the anon key)

# --- Resend ---
RESEND_API_KEY=re_...                   # Resend Dashboard -> API Keys
FROM_EMAIL=Armonía <no-reply@armonia-mariachi.com>   # must be on a domain verified in Resend

# --- Site URLs ---
SITE_URL=https://armoniaconnect.com
COURSE_SITE_URL=https://armoniaconnect.com/course

# --- Sessions ---
SESSION_SECRET=replace-with-a-long-random-string    # generate with: openssl rand -hex 32

# --- Admin panel (yours only — don't share) ---
ADMIN_PASSWORD=choose-something-only-you-know

# --- Merch store: fulfilment suppliers ---
# Without these the store still sells; orders simply wait in the admin as
# "paid" until you send them yourself. With them, paid orders are made and
# shipped automatically and tracking is emailed to the customer.
#
# Printful: apparel and stickers.
#   Dashboard -> Settings -> API  (a store-level token is enough)
PRINTFUL_API_TOKEN=
#   Only needed if the Printful account has more than one store:
# PRINTFUL_STORE_ID=12345678
#   Set to 1 to build orders WITHOUT printing or charging — use this for the
#   first end-to-end test order before you go live.
# PRINTFUL_DRAFT=1
#   Printful has no webhook signing secret, so the callback URL carries a shared
#   token. Add the webhook in Printful pointing at:
#     https://your-domain/api/store/supplier-webhook?token=<this value>
#   and subscribe it to package_shipped, order_failed and package_canceled.
PRINTFUL_WEBHOOK_TOKEN=

# PrintKK: the pick set (Printful does not carry guitar picks).
#   Dashboard -> Setting -> API Management. Both values are needed — requests
#   are HMAC-signed with the secret, not just authenticated with the key.
PRINTKK_API_KEY=
PRINTKK_SECRET_KEY=
#   PrintKK orders are created unpaid and paid from a prepaid wallet. Leave this
#   unset until you are happy the mapping is right: paying cannot be undone.
# PRINTKK_AUTO_PAY=1

# PrintKK has no webhooks at all, so tracking is polled. Vercel Cron calls
# /api/store/supplier-sync with this secret; set the same value here.
CRON_SECRET=

# --- Merch store (all optional; sensible defaults are built in) ---
# STORE_SHIPPING_FEE_CENTS=600        # flat standard US shipping, in cents (default 600 = $6)
# STORE_FREE_SHIPPING_CENTS=7500      # free shipping threshold, in cents (default 7500 = $75)

# --- Local development only ---
# STORE_LOCAL_DB=1                    # run the store against .tmp/store-db.json instead of Supabase
