# Copy this file's contents into Vercel: Project -> Settings -> Environment Variables
# Never commit a real .env file to GitHub.

# --- Stripe ---
STRIPE_SECRET_KEY=sk_live_...           # Stripe Dashboard -> Developers -> API keys
STRIPE_WEBHOOK_SECRET=whsec_...         # Given to you when you register the webhook (README step 4)

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co  # Supabase Dashboard -> Project Settings -> API
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # Same page -> "service_role" key (NOT the anon key)

# --- Resend ---
RESEND_API_KEY=re_...                   # Resend Dashboard -> API Keys
FROM_EMAIL=Armonía <no-reply@armonia-mariachi.com>   # must be on a domain verified in Resend

# --- Site URLs ---
SITE_URL=https://armoniaconnect.com
COURSE_SITE_URL=https://armoniaconnect.com/course

# --- Sessions ---
SESSION_SECRET=replace-with-a-long-random-string    # generate with: openssl rand -hex 32

# --- Admin panel (yours only — don't share) ---
ADMIN_PASSWORD=choose-something-only-you-know
